    "@tabler/icons-vue": "^3.36.0",
    "@unhead/vue": "^2.1.0",
    "@vueuse/core": "^14.1.0",
    "animejs": "^4.2.2",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "discord-markdown": "^2.5.1",
    "lodash-es": "^4.17.22",
    "pinia": "^3.0.4",
    "unplugin-auto-import": "^20.3.0",
    "vue": "^3.5.26",
    "vue-hotjar-next": "^2.1.0",
    "vue-i18n": "^11.2.7",
