    "@vue/tsconfig": "^0.8.1",
    "discord-api-types": "^0.37.67",
    "eslint": "^8.22.0",
    "eslint-plugin-vue": "^10.4.0",
    "naive-ui": "^2.35.0",
    "prettier": "^2.7.1",
    "typescript": "^5.3.2",
    "unocss": "^66.5.1",
    "vite": "^7.1.6",
    "vite-plugin-vue-devtools": "^8.0.2",
