    "@vue/tsconfig": "^0.8.1",
    "discord-api-types": "^0.38.37",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "naive-ui": "^2.43.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
