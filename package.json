    "@unhead/vue": "^1.8.9",
    "@vueuse/core": "^10.7.2",
    "animejs": "^3.2.1",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "discord-markdown": "^2.5.1",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "unplugin-auto-import": "^20.1.0",
    "vue": "^3.5.21",
    "vue-hotjar-next": "^2.0.1",
    "vue-i18n": "^9.7.1",
